PRODUCT_NAME = EmbraceWorker
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_IDENTIFIER_PREFIX).EmbraceNG.EmbraceWorker
INFOPLIST_FILE = Resources/Worker-Info.plist
GCC_PRECOMPILE_PREFIX_HEADER = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) /Library/Frameworks
CODE_SIGN_ENTITLEMENTS = Resources/Worker.entitlements
ALWAYS_SEARCH_USER_PATHS = NO

// bpmcore and the transform under it, both vendored -- see Vendor/PROVENANCE.md.
// Consumers say #include <bpmcore/bpmcore.h>, so it is the Vendor directory
// itself that goes on the search path and not either library's own.
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/Vendor

// Which transform the spectral stage uses, and at what width.  Two answers
// rather than one because they are two questions: the width is a property of
// the analyser and is the only one of the two that can move a BPM or a class,
// and the backend should agree with the other at a fixed width to rounding.
// pffft has no double variant, so the pair is not free -- real_fft.cpp refuses
// to compile if one is changed without the other.
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) BPMCORE_FFT_PFFFT BPMCORE_FFT_SCALAR_TYPE=float

// Link-time optimisation, for the optimised configurations only.
//
// The worker is where it pays: bpmcore, pffft and the loudness measurer are a
// dozen C and C++ translation units that call each other constantly, and
// without this the optimiser never sees across one of those boundaries.
// Measured on a Release install it takes the worker from 686KB to 653KB, a
// little under 5%, for about ten seconds of extra link time.
//
// It is deliberately not on the app target.  The same measurement there moves
// 1,554,944 bytes to 1,554,784 -- 160 bytes, which is nothing -- and the app
// is where declick, dehum and the parametric EQ live.  Those carry per-file
// -O2 and hand-written accumulator loops tuned against a real-time deadline,
// and perturbing their codegen for no measurable size win is a bad trade.
//
// Thin LTO was measured too and is worse than either: cross-module inlining
// under -Os made the app 33KB *larger* and left the worker unchanged.
LLVM_LTO[config=Release]    = YES
LLVM_LTO[config=Submission] = YES
